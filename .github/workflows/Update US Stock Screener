
name: Update US Stock Screener

on:
  workflow_dispatch:
  schedule:
    - cron: "30 23 * * 1-5"

permissions:
  contents: write

jobs:
  update-us-screener:
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install pandas yfinance

      - name: Build US stock screener data
        run: python scripts/build_us_screener.py

      - name: Commit updated US stock data
        run: |
          if [ -f data/us_stocks.json ]; then
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add data/us_stocks.json
            if ! git diff --cached --quiet; then
              git commit -m "Update US stock screener data"
              git push
            else
              echo "No data changes to commit."
            fi
          else
            echo "ERROR: data/us_stocks.json was not created."
            exit 1
          fi
